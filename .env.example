# ── LLM Provider ────────────────────────────────────────────────────────────
# Only "groq" is currently supported.
LLM_PROVIDER=groq

# ── Groq API Key (required) ────────────────────────────────────────────────
# Obtain your key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ── Model name (optional, default: llama-3.3-70b-versatile) ────────────────────────
# Any Groq model that supports structured output may be used.
# Examples: llama-3.3-70b-versatile, llama-3.1-8b-instant
GROQ_MODEL=llama-3.3-70b-versatile

# ── Extractor retry budget (optional, default: 3) ───────────────────────────
# Number of times instructor will retry the LLM on a malformed response
# before raising ExtractionError.
EXTRACTOR_MAX_RETRIES=3
